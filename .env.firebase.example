# ============================================================================
# Template setelan Firebase untuk Rara Travel.
#
#   cp .env.firebase.example .env.firebase   →  lalu isi Project ID
#   bash tools/setup_firebase.sh             →  jalankan semua langkah
#   bash tools/setup_firebase.sh --check     →  periksa saja
#
# BERKAS ASLI (.env.firebase) JANGAN DICOMMIT — sudah ada di .gitignore.
# Project ID bukan rahasia, tapi file ini bisa berkembang berisi path lokal.
# ============================================================================

# Wajib. Firebase Console → Project settings → General → Project ID
# (bukan Display name). Contoh: rara-travel-a1b2c
FIREBASE_PROJECT_ID=
