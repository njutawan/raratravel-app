# ============================================================================
# Template setelan Supabase untuk Rara Travel.
#
#   cp .env.supabase.example .env.supabase   →  lalu isi nilainya
#   bash tools/setup_supabase.sh             →  jalankan semua langkah
#
# BERKAS ASLI (.env.supabase) JANGAN DICOMMIT — sudah ada di .gitignore.
# Berkas ini hanya contoh; aman disimpan di repositori.
# ============================================================================

# --- Wajib -------------------------------------------------------------------
# Project ref: Dashboard → Project Settings → General (atau dari URL
# https://supabase.com/dashboard/project/<project-ref>).
SUPABASE_PROJECT_REF=

# Password database yang dibuat saat membuat proyek (Dashboard → Settings →
# Database → Reset database password bila lupa).
SUPABASE_DB_PASSWORD=

# Kunci publik proyek (Dashboard → Settings → API → Project API keys → anon).
# Boleh dikosongkan: skrip akan mencoba mengambilnya sendiri lewat CLI.
SUPABASE_ANON_KEY=
SUPABASE_URL=

# service_role: RAHASIA. Hanya dipakai Edge Function, jangan pernah masuk
# ke aplikasi Flutter.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (login & FCM tetap memakai Firebase).
# Project ID: Firebase Console → Project settings → General → Project ID.
FIREBASE_PROJECT_ID=

# Berkas JSON service account: Firebase Console → Project settings →
# Service accounts → Generate new private key. Simpan DI LUAR repositori.
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- Opsional (sesuai fitur yang dipakai) ------------------------------------
# Dibuat otomatis oleh skrip bila dikosongkan (openssl rand -hex 24).
NOTIFY_WEBHOOK_SECRET=

# Midtrans (bila "Bayar Sekarang" diaktifkan).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (bila dipakai) dan fallback HMAC provider lain.
XENDIT_CALLBACK_TOKEN=
PAYMENT_HMAC_SECRET=

# CORS untuk panel admin web. Biarkan * selama aplikasi hanya mobile.
ALLOWED_ORIGINS=*
